# Copia este archivo a .env (NO lo subas a git) y completa los valores.
DB_USER=vidaplena_app
DB_PASSWORD=cambia-esta-contrasena-larga
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=vidaplena
# En producción: require o verify-full (conexión cifrada con TLS)
# DB_SSLMODE=require
# Llave de cifrado de teléfonos: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
SESSION_TIMEOUT_MIN=20
# Plazo de respuesta ARCO (días hábiles). VERIFICAR con la LFPDPPP vigente.
ARCO_DIAS_HABILES=20
